{
  "name": "healing-hands-theme",
  "private": true,
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i wp-theme/healing-hands/src/main.css -o wp-theme/healing-hands/assets/css/main.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i wp-theme/healing-hands/src/main.css -o wp-theme/healing-hands/assets/css/main.css --watch",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "node-html-parser": "^9.0.6",
    "tailwindcss": "^3.4.19"
  }
}
